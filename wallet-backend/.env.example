# Copy to .env and adjust. Every value below has a working default in code
# (see internal/sharedconfig/config.go) except where noted - the service
# boots with none of these set, using SQLite + console mail/SMS/push.

PORT=8080
ORGANISATION=wallet-backend

# --- Database ---------------------------------------------------------------
# DB_TYPE=sqlite for local dev (no server required), DB_TYPE=postgres for
# anything beyond that.
DB_TYPE=sqlite
DB_CONNECTION_STRING=wallet-backend.sqlite
# DB_TYPE=postgres
# DB_CONNECTION_STRING=host=localhost user=postgres password=postgres dbname=wallet_backend port=5432 sslmode=disable
DB_AUTOMIGRATE=true
# Connection pool - unset previously meant an unbounded pool with no
# exhaustion signal to alert on at all (see PLAN.md §4.13).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# --- Base blockchain -----------------------------------------------------------
# Defaults to Base Sepolia (the testnet) rather than mainnet, so a forgotten
# env var can never accidentally point a fresh checkout at real funds.
# Base Mainnet:  BASE_RPC_URL=https://mainnet.base.org  BASE_CHAIN_ID=8453
# Base Sepolia:  BASE_RPC_URL=https://sepolia.base.org  BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# --- Cache (Redis) ------------------------------------------------------------
ENABLE_CACHING=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email ---------------------------------------------------------------------
USE_CONSOLE_MAILER=true
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- File storage --------------------------------------------------------------
STORAGE_DIR=./data/uploads
STORAGE_URL=/files

# --- Alerting --------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=      # leave blank to disable operational alerts

# --- Auth ------------------------------------------------------------------------
# JWT_SECRET signs both the wallet-session tokens issued after a successful
# SIWE verification (see /v1/auth) and the admin-surface tokens - the two
# are kept apart by an audience claim, not a separate secret (see
# internal/middleware/jwt_auth.go).
JWT_SECRET=dev-only-change-me
JWT_EXPIRY_MINUTES=60
# SIWE_DOMAIN must match the "domain" field every client-signed Sign-In With
# Ethereum message declares (EIP-4361) - typically your API's own hostname.
SIWE_DOMAIN=localhost

# GROUP_KEY_SALT seeds shared-access group wallet key derivation (see
# internal/components/sharedaccess). Changing this changes every existing
# group's controlling address - treat it like a secret, generate a real
# random value for any non-dev environment, and never rotate it once
# groups exist in production.
GROUP_KEY_SALT=dev-only-change-me

# RECOVERY_AUTHORITY_SALT seeds the account-recovery attestation key (see
# internal/components/users/services/recovery.go) - same rotation caution as
# GROUP_KEY_SALT: generate a real random value for any non-dev environment.
# RECOVERY_OTP_TTL_MINUTES controls how long an emailed recovery code stays
# valid before a caller must request a new one.
RECOVERY_AUTHORITY_SALT=dev-only-change-me
RECOVERY_OTP_TTL_MINUTES=15

# Sumsub/Dojah KYC credentials (see internal/components/kyc). Leave blank
# in dev - Sumsub calls will fail closed with a clear error, and both
# webhook endpoints reject every request when their secret is unset rather
# than accepting an unverified payload.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_TOKEN=
SUMSUB_SECRET_KEY=
DOJA_SECRET_KEY=

# FAUCET_KEY_SALT seeds the activation-faucet key derivation (see
# internal/components/fiat) - same rotation caution as GROUP_KEY_SALT: fund
# whatever address this derives with ETH (and the reward token, if
# configured) before enabling activation in production.
FAUCET_KEY_SALT=dev-only-change-me
# ACTIVATION_REWARD_TOKEN_SYMBOL must match a CuratedToken.Symbol (see
# internal/components/assets) to enable the reward-token half of
# activation; leave blank to dispense starter gas only.
ACTIVATION_REWARD_TOKEN_SYMBOL=
# FAUCET_LOW_BALANCE_THRESHOLD_ETH triggers a Discord alert (checked every
# 30 minutes) once the activation faucet's balance drops at or below this
# many ETH; 0 disables the check (see PLAN.md §4.13).
FAUCET_LOW_BALANCE_THRESHOLD_ETH=0

# Flutterwave credentials (see internal/fiat/flutterwave and
# internal/components/fiat). FLUTTERWAVE_SECRET_KEY is the API secret key
# (Bearer token for outbound calls, unused by this port's actual
# activation/invoice flow but required to construct the processor).
# FLUTTERWAVE_SECRET_HASH is the dashboard's "Secret Hash" webhook setting -
# leave both blank to leave fiat payments disabled (GlobalConfig.Fiat
# stays nil, matching internal/fiat's documented default).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Stablerail credentials (see internal/components/stablerail).
# STABLERAIL_ENABLED must be explicitly set true - every route and the
# Doja-BVN-completion onboarding hook return a 202 "not enabled" response
# while it's false, regardless of whether an API key is set.
STABLERAIL_ENABLED=false
STABLERAIL_API_KEY=
STABLERAIL_BASE_URL=https://beta.stablesrail.io/v1

# OneLiquidity credentials (see internal/components/crypto). The deposit
# poller only runs when ONELIQUIDITY_TOKEN is set. CRYPTO_TREASURY_KEY_SALT
# seeds the treasury key deposits are credited from and withdrawal debits
# are collected into - same rotation caution as GROUP_KEY_SALT: fund
# whatever address this derives with each curated token before enabling
# deposits in production. CRYPTO_WALLET_DOMAIN is the suffix OneLiquidity
# subwallet UIDs are keyed by (username@CRYPTO_WALLET_DOMAIN).
ONELIQUIDITY_BASE_URL=https://sandbox-api.oneliquidity.technology
ONELIQUIDITY_TOKEN=
CRYPTO_WALLET_DOMAIN=wallet-backend
CRYPTO_TREASURY_KEY_SALT=dev-only-change-me
CRYPTO_WITHDRAWAL_SERVICE_FEE_PERCENT=1.0

# MARKET_ESCROW_KEY_SALT seeds the market-making escrow key derivation
# (see internal/components/market) - same rotation caution as
# GROUP_KEY_SALT: a maker's approve() targets the address this currently
# derives to, so rotating it orphans any standing approvals.
MARKET_ESCROW_KEY_SALT=dev-only-change-me

# TOKENIZATION_ISSUER_KEY_SALT/TOKENIZATION_DISTRIBUTION_KEY_SALT seed the
# per-asset issuer (contract owner/mint authority) and distribution
# (treasury/proceeds) key derivations (see internal/components/
# tokenization) - same rotation caution as MARKET_ESCROW_KEY_SALT:
# rotating either orphans every already-minted asset's on-chain contract
# ownership. TOKENIZATION_TOKEN_LIMIT caps NumberOfTokenToBeIssued on a
# new application; 0 means no cap.
TOKENIZATION_ISSUER_KEY_SALT=dev-only-change-me
TOKENIZATION_DISTRIBUTION_KEY_SALT=dev-only-change-me
TOKENIZATION_TOKEN_LIMIT=0

# PATRON_FEE_WALLET_SALT seeds the patron-subscription fee wallet key
# derivation (see internal/components/patron) - same rotation caution as
# every other derived fee-collection address in this port.
# PATRON_VAT_PERCENT is applied on top of each subscription's price.
PATRON_FEE_WALLET_SALT=dev-only-change-me
PATRON_VAT_PERCENT=0

# SERVICELINK_APPROVAL_TTL_MINUTES is how long a partner's login/authorize/
# event consent request (see internal/components/servicelinks) stays
# pending before it expires unactioned.
SERVICELINK_APPROVAL_TTL_MINUTES=10

# GEOIP_BASE_URL points at an ipapi.co-shaped free-text country lookup
# (GET {baseURL}/{ip}/country/); leave blank to disable geo-IP entirely -
# registration works identically either way (see PLAN.md §4.13).
GEOIP_BASE_URL=

# SHORTLINK_BASE_URL is prefixed to a short code to build the public short
# URL a generated QR code encodes (see internal/components/shortlink).
SHORTLINK_BASE_URL=http://localhost:8080
