# Copy to .env and adjust. Every value below has a working default in code
# (see internal/sharedconfig/config.go) except where noted - the service
# boots with none of these set, using SQLite + console mail/SMS/push.

PORT=8080
ORGANISATION=wallet-backend

# --- Database ---------------------------------------------------------------
# DB_TYPE=sqlite for local dev (no server required), DB_TYPE=postgres for
# anything beyond that.
DB_TYPE=sqlite
DB_CONNECTION_STRING=wallet-backend.sqlite
# DB_TYPE=postgres
# DB_CONNECTION_STRING=host=localhost user=postgres password=postgres dbname=wallet_backend port=5432 sslmode=disable
DB_AUTOMIGRATE=true

# --- Base blockchain -----------------------------------------------------------
# Defaults to Base Sepolia (the testnet) rather than mainnet, so a forgotten
# env var can never accidentally point a fresh checkout at real funds.
# Base Mainnet:  BASE_RPC_URL=https://mainnet.base.org  BASE_CHAIN_ID=8453
# Base Sepolia:  BASE_RPC_URL=https://sepolia.base.org  BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# --- Cache (Redis) ------------------------------------------------------------
ENABLE_CACHING=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email ---------------------------------------------------------------------
USE_CONSOLE_MAILER=true
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- File storage --------------------------------------------------------------
STORAGE_DIR=./data/uploads
STORAGE_URL=/files

# --- Alerting --------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=      # leave blank to disable operational alerts

# --- Auth ------------------------------------------------------------------------
# JWT_SECRET signs both the wallet-session tokens issued after a successful
# SIWE verification (see /v1/auth) and the admin-surface tokens - the two
# are kept apart by an audience claim, not a separate secret (see
# internal/middleware/jwt_auth.go).
JWT_SECRET=dev-only-change-me
JWT_EXPIRY_MINUTES=60
# SIWE_DOMAIN must match the "domain" field every client-signed Sign-In With
# Ethereum message declares (EIP-4361) - typically your API's own hostname.
SIWE_DOMAIN=localhost

# GROUP_KEY_SALT seeds shared-access group wallet key derivation (see
# internal/components/sharedaccess). Changing this changes every existing
# group's controlling address - treat it like a secret, generate a real
# random value for any non-dev environment, and never rotate it once
# groups exist in production.
GROUP_KEY_SALT=dev-only-change-me
