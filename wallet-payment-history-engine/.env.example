# Copy to .env and adjust. Every value below has a working default in code
# (see internal/sharedconfig/config.go) - the engine boots with none of
# these set, against SQLite and Base Sepolia.

# --- Database ---------------------------------------------------------------
# The SAME database wallet-backend uses (PLAN.md §2: one shared Postgres
# instance, not a second dedicated database as the original had). This
# engine only ever migrates its own three tables (payment_history,
# tracked_wallets, indexer_cursors) - it reads wallet-backend's
# user_wallets/curated_tokens tables but never migrates or writes them.
DB_TYPE=sqlite
DB_CONNECTION_STRING=wallet-payment-history-engine.sqlite
# DB_TYPE=postgres
# DB_CONNECTION_STRING=host=localhost user=postgres password=postgres dbname=wallet_backend port=5432 sslmode=disable
DB_AUTOMIGRATE=true

# --- Base blockchain ---------------------------------------------------------
# Defaults to Base Sepolia (the testnet), matching wallet-backend's own
# default, so a forgotten env var never points a fresh checkout at real funds.
# Base Mainnet:  BASE_RPC_URL=https://mainnet.base.org  BASE_CHAIN_ID=8453
# Base Sepolia:  BASE_RPC_URL=https://sepolia.base.org  BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# How often the live indexer polls for new blocks (PLAN.md §3.2 - matches
# wallet-backend's own AddressWatcher cadence).
POLL_INTERVAL_SECONDS=4

# The earliest block the backfill watcher will scan for a newly tracked
# wallet (PLAN.md §3.2). 0 means genesis - fine for a low-activity testnet,
# but set this to the block your app went live at on mainnet, so backfill
# doesn't scan years of irrelevant history for every new wallet.
BACKFILL_FLOOR_BLOCK=0

# --- Alerting -----------------------------------------------------------------
# Optional. Unset means alerts are dropped (NoopNotifier) - the engine's
# core behavior never depends on this being configured.
DISCORD_WEBHOOK_URL=
