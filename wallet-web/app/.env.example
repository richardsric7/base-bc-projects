# Copy to .env and adjust. All values here are Vite build-time values
# (baked into the JS bundle, not read at container start - see
# ../DEPLOYMENT.md §2) except VITE_DEFAULT_NETWORK, which only picks the
# *default* selection for the in-app testnet/mainnet switch
# (src/config/network.ts) - both networks' URLs/chain IDs ship in every
# build, and a user (or you, via localStorage/the Settings page) can
# switch between them at runtime without a rebuild.

# Base Sepolia (testnet) wallet-backend - matches that service's own
# BASE_CHAIN_ID=84532 default, so this works against a local
# `docker compose up` with zero configuration.
VITE_WALLET_BACKEND_URL_TESTNET=http://localhost:8080
VITE_CHAIN_ID_TESTNET=84532

# Base mainnet wallet-backend. Leave blank in dev - the in-app switch
# disables the "Mainnet" option whenever this is empty, so an
# unconfigured build can never silently point at a mainnet backend that
# doesn't exist. Fill in with your real production wallet-backend URL
# and 8453 before shipping a build that should offer mainnet at all.
VITE_WALLET_BACKEND_URL_MAINNET=
VITE_CHAIN_ID_MAINNET=8453

# Which network a fresh (no localStorage yet) visit defaults to -
# "testnet" or "mainnet". Defaults to testnet for the same reason
# wallet-backend's own BASE_CHAIN_ID defaults to Sepolia: a forgotten env
# var must never silently point a fresh deployment at real funds.
VITE_DEFAULT_NETWORK=testnet
