server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript application/wasm;

  # PLAN.md §7's CSP hardening: script-src 'self' with no unsafe-inline/
  # unsafe-eval (WASM instantiation via instantiateStreaming needs
  # neither); connect-src is the actual wallet-backend origin, templated
  # in at container start via envsubst - same pattern as BACKEND_URL
  # below, not a third-party CDN.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${BACKEND_URL}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # wallet_core_bg.wasm must be served with the correct MIME type for
  # instantiateStreaming to work without a fallback path.
  location ~* \.wasm$ {
    add_header Content-Type application/wasm;
    try_files $uri =404;
  }
}
